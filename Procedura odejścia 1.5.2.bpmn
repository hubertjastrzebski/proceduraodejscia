<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_1x49b8h" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.52.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.10.0">
  <bpmn:collaboration id="Collaboration_12nivlj">
    <bpmn:participant id="Participant_1oj3du9" name="Proces odejścia personelu" processRef="Process_04rut9h" />
    <bpmn:participant id="Participant_0mvxuxl" name="E. Przekazanie obowiązków" processRef="Process_0o246zg" />
    <bpmn:participant id="Participant_ProceduraIncydentow" name="Procedura obsługi zdarzeń i incydentów bezpieczeństwa" />
    <bpmn:participant id="Participant_DostawcaMonitoringu" name="Zewnętrzny dostawca monitoringu bezpieczeństwa" />
    <bpmn:participant id="Participant_OdebranieDostepow" name="B. Odebranie dostępów" processRef="Process_OdebranieDostepow" />
    <bpmn:participant id="Participant_ZwrotSprzetu" name="F. Zwrot sprzętu" processRef="Process_ZwrotSprzetu" />
    <bpmn:participant id="Participant_0idtl60" name="C. Przegląd bezpieczeństwa" processRef="Process_1rk2rin" />
    <bpmn:participant id="Participant_ZamrozenieDanych" name="D. Zamrożenie danych" processRef="Process_ZamrozenieDanych" />
    <bpmn:messageFlow id="Flow_1fqzwrh" name="Przekierowanie alertów" sourceRef="Activity_PrzekierowanieDLPSP" targetRef="Participant_DostawcaMonitoringu" />
    <bpmn:messageFlow id="Flow_0crh0g4" name="Zgłoszenie nieobecności" sourceRef="Activity_ZgloszenieNieobecnosci" targetRef="Participant_ProceduraIncydentow" />
    <bpmn:messageFlow id="Flow_1gnok3h" name="Zgłoszenie podejrzenia naruszenia" sourceRef="Activity_04pyp6x" targetRef="Participant_ProceduraIncydentow" />
    <bpmn:messageFlow id="Flow_1cuooje" sourceRef="Participant_ProceduraIncydentow" targetRef="Event_1kionjs" />
    <bpmn:messageFlow id="Flow_1gafldc" sourceRef="Activity_13nd3y7" targetRef="Participant_DostawcaMonitoringu" />
    <bpmn:textAnnotation id="TextAnnotation_1310p1t">
      <bpmn:text>• Sposób odejścia
• Kontekst
• Stopień dostępu
• Stopień stanowiska
• Wiedza</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0lxhfoz">
      <bpmn:text>Lista personelu zawiera każdą osobę z jakimkolwiek dostępem, w tym pracowników kontrahentów i klientów. Zawiera osobę odpowiedzialną (przełożony dla personelu wewnętrznego, kontakt kontrahenta lub klienta dla personelu zewnętrznego), dostęp, rodzaj współpracy, podpisane oświadczenia i istniejące akta sprawy. Źródła odnotowania odejścia: people operations, kontrahent, okresowa kontrola listy, inne.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1i0q0rj">
      <bpmn:text>Przekazuje odchodzący, nadzoruje osoba odpowiedzialna.
Ścieżka standardowa: do odebrania dostępów odchodzący pracuje normalnie.
Jeśli współpraca zostanie zakończona przed zakończeniem przekazania, jest ono kontynuowane bez udziału odchodzącego.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1ir1w5s">
      <bpmn:text>• Pliki przeniesione, nic nie zależy już od konta odchodzącego
• Otwarte zadania przekazane
• Brak firmowych danych na prywatnych urządzeniach i kontach (5.11)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_066akz5">
      <bpmn:text>• Ankieta końcowa
• Weryfikacja, czy nie ma podstaw do eskalacji ryzyka
• Weryfikacja, czy lista personelu wyczerpuje dostępy do odebrania
• Wysokiego ryzyka: nagrywana jawnie, cel podany na początku; nagranie lub transkrypcja od razu do obsługi prawnej, przechowywane 90 dni, chyba że potrzebne z przyczyn prawnych</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0vy92g1">
      <bpmn:text>• laptop, telefon, tokeny, klucze, karty: sprawdzenie, czy wróciło wszystko, co wydano (5.11)
• osoba pracująca zdalnie nadaje sprzęt w dniu odebrania dostępów
• braki lub ślady ingerencji: zgłoszenie zmiany okoliczności</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_04qg17e">
      <bpmn:text>Od odebrania dostępów do tego dnia trwa bufor czasowy: miejsce na eskalację i odbiór sprzętu.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1629zgu">
      <bpmn:text>Szczegóły poza procedurą: dokumenty i rozliczenia prowadzą people operations, finanse i obsługa prawna według swoich zasad, zależnie od rodzaju współpracy.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1t5tic9">
      <bpmn:text>Procedura obsługi zdarzeń i incydentów bezpieczeństwa, poza zakresem: ocena (5.25); reakcja (5.26); zabezpieczenie dowodów (5.28). Do ścieżki wraca wynik weryfikacji (6.4).</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_098zl91">
      <bpmn:text>Ta sama tablica DMN z aktualnymi danymi.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0zjlgxh">
      <bpmn:text>• data odebrania dostępów
• co obowiązuje po odejściu: poufność (6.5)
• prośba o przekazanie tego odchodzącemu
• weryfikacja, czy nie ma podstaw do eskalacji ryzyka
• weryfikacja, czy lista personelu wyczerpuje dostępy do odebrania</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1tfynk1">
      <bpmn:text>Gałęzie zależą od tego, za co odpowiada odchodzący.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_09ya1m5">
      <bpmn:text>• następcy w zatwierdzeniach, dyżurach i rolach administratora lub właściciela (5.9, 6.5)
• to, co zależy od konta odchodzącego: tokeny w integracjach, zaplanowane zadania, subskrypcje opłacane jego kartą firmową</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_02daxzx">
      <bpmn:text>Następcy przedstawieni klientom, dostawcom i partnerom (6.5); moment wybiera osoba odpowiedzialna.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1hzfe73">
      <bpmn:text>Udokumentowana i przekazana (5.11).</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_16kepbu">
      <bpmn:text>Pliki z dysków i folderów osobistych do wspólnych.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_76">
      <bpmn:text>Przekazanie z udziałem odchodzącego, dokończenie bez niego, przekazanie po blokadzie i odtworzenie z dokumentacji to strukturalnie ten sam proces.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_63">
      <bpmn:text>Wpisy odchodzącego z listy personelu w zakresie wywołania (uprzywilejowane, pozostałe albo wszystkie), pogrupowane według właścicieli. Każdy wpis mówi, kto odbiera, jak (wyłączenie, blokada, zmiana lub prośba do strony zewnętrznej) i na jakim poziomie.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_64">
      <bpmn:text>Każdą pozycję z listy personelu obsługuje się osobno: odebranie, blokada lub zmiana dostępu według jej wpisu na liście personelu oraz zapis daty i osoby wykonującej.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_65">
      <bpmn:text>• Konta w systemach klientów i dostawców
• Przepustki do zakładów klientów</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_66">
      <bpmn:text>• Konto służbowe (SSO)
• Skrzynka pocztowa
• Narzędzia poza SSO (osobne loginy)
• Konta współdzielone, np. media społecznościowe: zmiana hasła
• Blokada urządzeń służbowych
• Dostęp do biura: karta, klucze, kody</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_67">
      <bpmn:text>• Środowisko produkcyjne
• Konsole administracyjne chmury
• Pipeline wdrożeniowy (CI/CD)
• Zmiana sekretów: hasła do baz danych, klucze API</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_68">
      <bpmn:text>• Bankowość elektroniczna
• Zatwierdzanie płatności
• Karta firmowa
• Prawo reprezentacji i pełnomocnictwa: przekazanie do obsługi prawnej</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0z2muo1">
      <bpmn:text>Każdy wpis z zestawienia obsłużony i zapisany (5.18).</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_58">
      <bpmn:text>Kopie kont, skrzynki i danych, jeśli nie powstały wcześniej.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_59">
      <bpmn:text>Jeden łączny warunek zamiast osobnego czekania w każdym przypadku. Lista warunków jest otwarta.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_62">
      <bpmn:text>Akta zamyka Pełnomocnik ds. ISMS (ISO/IEC 27001, 7.5).</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_83">
      <bpmn:text>Osoba pracująca zdalnie nadaje sprzęt w dniu odebrania dostępów; na ścieżce Wysokiego ryzyka kurier przywozi dokumenty i odbiera sprzęt z podpisanymi egzemplarzami w dniu rozmowy.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_84">
      <bpmn:text>Laptop, telefon, tokeny, klucze, karty: sprawdzenie, czy wróciło wszystko, co wydano (5.11).</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0kb3v51">
      <bpmn:text>Obsługa prawna ogranicza zakres tylko tam, gdzie wymaga tego prawo.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_071vvqu">
      <bpmn:text>• Aplikacje i usługi używane z kontem lub adresem służbowym (shadow IT)
• Dostępy niewpisane na listę personelu
• Masowe pobrania, eksporty i usunięcia danych
• Przekazywanie danych poza firmę (poczta, udostępnienia, nośniki)
• Nietypowa aktywność (godziny, urządzenia, okresy nieobecności)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0c4vbo6">
      <bpmn:text>• Klucze, tokeny i usługi zewnętrzne dodane przez odchodzącego (shadow IT)
• Dostęp do danych klientów i ich eksporty
• Zmiany w środowisku produkcyjnym i pipeline wdrożeniowym bez zgłoszenia
• Pobrania kodu i odczyty sekretów
• Wyłączone lub osłabione zabezpieczenia (dzienniki zdarzeń, monitoring, kopie zapasowe)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0l129ne">
      <bpmn:text>• Subskrypcje i usługi opłacane kartą firmową lub zgłoszone do zwrotu (shadow IT)
• Płatności i faktury zatwierdzone przez odchodzącego
• Zmiany danych dostawców (nowi dostawcy, rachunki bankowe)
• Niestandardowe operacje (zwroty, korekty, wypłaty gotówki)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_05a66pk">
      <bpmn:text>Podwyższonego i wysokiego ryzyka: Wczesne odebranie dostępów uprzywilejowanych. Wyjątek tylko z uzasadnieniem właściciela wpisu dostępu, zapisanym w aktach.
Odchodzący nie bierze udziału: Odebranie wszystkich dostępów.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0nhrgam">
      <bpmn:text>Obejmuje decyzję o trybie: czy z udziałem odchodzącego i czy z jego dostępami. Na ścieżce wysokiego ryzyka w konsultacji z obsługą prawną.
Bez udziału odchodzącego: przeniesienie ról, własności i danych z pomocą administratorów, zapis wiedzy, której nie przekazano.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_34">
      <bpmn:text>• Przygotowanie dokumentów do rozmowy
• Pracownik klienta lub kontrahenta: wystosowanie prośby o rozmowę na podstawie podpisanych oświadczeń (5.20, 6.6)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_47">
      <bpmn:text>Fakty: osoba nieobecna od tygodnia, ze sprzętem firmy. Oceny sytuacji (przywłaszczenie, osoba zaginiona) dokonują służby.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_12v32to">
      <bpmn:text>Odejście z pracy nie ma miejsca np. w przypadku, gdy pracownik jest niezdolny do pracy w wyniku długotrwałej choroby. (ścieżka Odchodzący nie bierze udziału)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_31">
      <bpmn:text>Dotyczy tylko aktywności i danych uzyskanych od czasu pierwotnego przeglądu.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0bs2j47">
      <bpmn:text>• Z wyjątkiem kroków zebrania informacji i ustalenia ścieżki postępowania, każde dalsze działanie w ponowionej obsłudze odejścia jest uwarunkowane tym, że jego wykonanie nie zostało udokumentowane w aktach sprawy w zakresie odpowiadającym co najmniej obecnej ścieżce postępowania.
• Działanie przerwane zmianą ścieżki wznawia się od miejsca udokumentowanego w aktach sprawy, o ile umożliwia to wykonanie go w wymaganym od nowej ścieżki zakresie.
• Środki podjęte wcześniej, a wykraczające poza zakres nowej ścieżki postępowania, wycofuje się niezwłocznie po jej ustaleniu (o ile to możliwe).</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_11xbt7h">
      <bpmn:text>Konwencje:
• Domyślnie numeracja w nawiasach w nazwach i opisach kroków odpowiada numeracji w dokumentacji ISO/IEC 27002:2022 i stanowi odwołanie do jej treści pod danym numerem.
• Zdarzenie czasowe, którego termin już minął, lub warunkowe, którego warunek jest już spełniony, następuje natychmiast; zdarzenie brzegowe – w chwili rozpoczęcia kroku, do którego jest przypięte.
• Na ścieżkach „Wysokiego ryzyka” i „Odchodzący nie bierze udziału” terminy wyznaczone przez ostatni dzień faktycznej współpracy uznaje się za minione.
• Każde zadanie, decyzję, zdarzenie i wiadomość odnotowuje się w aktach sprawy.
• Znaki &lt; i &gt; w etykietach porównują ścieżki: Standardowa &lt; Podwyższonego ryzyka &lt; Wysokiego ryzyka &lt; Odchodzący nie bierze udziału. Czyta się je jako: "ścieżka niższa niż" i "ścieżka wyższa niż".
• Jeśli w aktach sprawy jest zdarzenie bezpieczeństwa bez wyniku oceny, nową ścieżkę postępowania ustala się dopiero po otrzymaniu tego wyniku.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1wwf36g">
      <bpmn:text>• Zgłoszenie potencjalnego przywłaszczenia lub zaginionego sprzętu
• Przekazanie numerów identyfikacyjnych, np. nr IMEI telefonu</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0z0gdcy">
      <bpmn:text>Kończy się odzyskaniem sprzętu albo decyzją Pełnomocnika o zaprzestaniu prób.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1gei1cf">
      <bpmn:text>• Ścieżka standardowa: 5 dni roboczych do ostatniego dnia faktycznej współpracy.
• Podwyższonego ryzyka: natychmiast po przekazaniu obowiązków, ale nie później niż 5 dni roboczych do zakończenia faktycznej współpracy.
• Pozostałe: natychmiast.</bpmn:text>
    </bpmn:textAnnotation>
